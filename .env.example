# Copy this file to .env for local development (loaded automatically via python-dotenv).
# In production (fps.ms or similar), set these as real Environment Variables in the host panel instead.

# Required to run bot/main.py
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
BOT_ADMIN_IDS=123456789,987654321

# Required only to run bot/data/telegram_imagenes.py (uploads watermarked
# images to a Telegram chat to obtain cacheable file_ids)
TELEGRAM_UPLOAD_CHAT_ID=123456789

# Optional overrides for pipeline/json_traducido.py. Leave commented out to use
# the defaults (the two external data repos cloned as siblings of this project,
# see ARCHITECTURE.md). Uncomment only if your clones live elsewhere.
# MARVELCDB_REPO_DIR=../pipeline/marvelsdb-json-data
# TRANSLATION_REPO_DIR=../freakmod

# Optional overrides for bot/live_update/soft_updater.py. If the repos above
# don't exist yet on the server, the soft updater clones them automatically
# from these URLs (defaults already point to the right forks, override only
# if you use your own fork/mirror).
# MARVELSDB_JSON_DATA_REPO_URL=https://github.com/zzorba/marvelsdb-json-data.git
# FREAKMOD_REPO_URL=https://github.com/Freakmod/marvelsdb-json-data.git

# Optional: how many timestamped snapshots to keep under bot/backups/ before
# /actualizar prunes the oldest ones. Defaults to 4.
# BOT_UPDATE_BACKUP_KEEP=4
